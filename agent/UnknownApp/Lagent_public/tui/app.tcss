/* ═══════════════════════════════════════════════════════════════════
   Lagent TUI —— 设计 token 体系
   所有颜色从 tui/theme.py（$变量名）取值，深浅主题一键切换。
   ═══════════════════════════════════════════════════════════════════ */

Screen {
    background: $bg;
    color: $text;
}

/* ── 主布局 ──────────────────────────────────────────────────────── */

#main-body {
    height: 1fr;
}

.sidebar {
    width: 30;
    min-width: 24;
    height: 1fr;
    background: $panel;
    /* 用一条 faint 的竖线区分左右栏，比 solid border-right 柔和 */
    border-right: $border-soft;
    padding: 1 0;
}

#chat-col {
    width: 1fr;
    height: 1fr;
}

/* ── 顶部品牌栏 ──────────────────────────────────────────────────── */

#topbar {
    height: 3;
    background: $panel;
    border-bottom: $border-soft;
    padding: 0 2;
}

#brand {
    width: 1fr;
    height: 3;
    content-align: left middle;
}

#meta {
    width: auto;
    max-width: 60%;
    height: 3;
    content-align: right middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */

.sidebar-panel {
    margin: 0 1 1 1;
}

.sidebar-header {
    height: 1;
    color: $accent;
    text-style: bold;
    padding: 0 1 0 1;
    /* 不要 border-bottom —— 让 header 和 body 自然融为一体 */
    margin-bottom: 1;
}

.sidebar-body {
    padding: 0 1;
    margin-top: 0;
    color: $text-dim;
}

/* ── 聊天区 ──────────────────────────────────────────────────────── */

ChatView {
    height: 1fr;
    padding: 1 2 0 2;
    background: $bg;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-color: $border-soft;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent-soft;
}

/* Welcome 面板：圆润卡片 + 柔和边框 */
.welcome {
    width: 1fr;
    background: $card;
    border: round $border;
    padding: 1 2;
    margin-bottom: 1;
    color: $text-dim;
}

/* 消息卡片：都用 round 统一风格，背景色拉开层次 */
.message {
    width: 1fr;
    margin-bottom: 1;
}

.user {
    background: $user-bg;
    border: round $user-border;
    border-title-color: $accent;
    padding: 1 2;
    color: $text-strong;
}

.assistant {
    background: $assistant-bg;
    border: round $assistant-border;
    border-title-color: $purple;
    padding: 1 2;
}

.assistant Markdown {
    background: transparent;
    padding: 0;
    margin: 0;
    color: $text;
}

/* Notice —— 不用 border-left 大色块，改成柔和的前缀 + color 区分 */
.notice {
    width: 1fr;
    margin-bottom: 0;
    padding: 0 2;
    color: $text-dim;
}

.notice.warn {
    color: $yellow;
}

.notice.error {
    color: $red;
}

/* ── 底部状态栏 ──────────────────────────────────────────────────── */

StatusBar {
    height: 2;
    background: $panel;
    border-top: $border-soft;
    padding: 0 2;
}

#status-main {
    width: 1fr;
    height: 1;
    content-align: left middle;
}

#status-hint {
    width: auto;
    max-width: 65%;
    height: 1;
    content-align: right middle;
    color: $text-faint;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ── 输入区 Composer ─────────────────────────────────────────────── */

Composer {
    height: auto;
    background: $panel;
    border-top: $border-soft;
    padding: 1 2;
}

#prompt {
    width: 3;
    height: 3;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#input {
    height: auto;
    min-height: 3;
    max-height: 10;
    border: round $border;
    background: $input-bg;
    padding: 0 1;
    color: $text;
    scrollbar-size-vertical: 1;
}

#input:focus {
    border: round $accent;
    background: $input-focus-bg;
}

Composer.busy #input {
    border: round $border-soft;
    color: $text-faint;
}

/* ── 命令补全面板 ────────────────────────────────────────────────── */

.command-palette {
    width: 62;
    min-height: 3;
    height: auto;
    background: $card;
    border: round $border-strong;
    padding: 1 1;
    margin-bottom: 1;
}

.resume-picker {
    width: 64;
}

.palette-body {
    color: $text;
}
